<?xml version="1.0"?>
<package format="3">
  <name>crane_model</name>
  <version>0.1.0</version>
  <description>Python crane model API: symbolic and numeric boundaries for planning and control.</description>
  <maintainer email="maintainers@example.invalid">Architecture maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- config/hydraulics.yaml, config/collision_model.yaml are read by the Python model. -->
  <!-- The Python model uses Pinocchio and Coal via their Python bindings. -->
  <depend>pinocchio</depend>
  <depend>coal</depend>
  <depend>casadi</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>

  <!-- Launch files -->
  <exec_depend>epsilon_crane_description</exec_depend>
  <exec_depend>pzs100_description</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- For the collision model derivation script -->
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>epsilon_crane_description</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
